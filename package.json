{
  "name": "forma-animation-studio",
  "version": "1.1.0",
  "description": "Desktop shape animation studio with keyframes, motion paths, linked text, media imports, and local exports",
  "author": "Echamma",
  "homepage": "https://github.com/Echamma/forma-animation-studio",
  "license": "UNLICENSED",
  "main": "main.cjs",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "prestart": "node scripts/bundle-renderer.cjs",
    "test": "node --test \"tests/unit/*.test.js\" && node scripts/generate-contract.cjs --check && electron tests/desktop.cjs && electron tests/mcp.cjs",
    "pretest": "node scripts/bundle-mcp.cjs && node scripts/bundle-renderer.cjs",
    "bundle": "node scripts/bundle-renderer.cjs",
    "build": "electron-builder --linux AppImage deb --x64 --publish never",
    "prebuild": "node scripts/bundle-renderer.cjs",
    "build:win": "electron-builder --win nsis portable --x64 --publish never",
    "prebuild:win": "node scripts/bundle-renderer.cjs",
    "start:mcp": "electron . --mcp",
    "prestart:mcp": "node scripts/bundle-renderer.cjs",
    "mcp": "node mcp/server.cjs",
    "mcp:contract": "node scripts/generate-contract.cjs",
    "mcp:build": "node scripts/bundle-mcp.cjs",
    "test:unit": "node --test \"tests/unit/*.test.js\""
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.25.12",
    "fflate": "0.8.3",
    "mediabunny": "1.61.3"
  },
  "build": {
    "appId": "local.forma.animationstudio",
    "productName": "Forma Animation Studio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "media-store.cjs",
      "build/renderer.js",
      "index.html",
      "style.css",
      "assets/fonts/**",
      "mcp/desktop-bridge.cjs",
      "mcp/validation.cjs",
      "mcp/tool_manifest.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "executableName": "forma-animation-studio",
      "category": "Graphics",
      "maintainer": "Echamma <Echamma@users.noreply.github.com>",
      "artifactName": "Forma-Animation-Studio-${version}-${arch}.${ext}"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Echamma",
        "repo": "forma-animation-studio"
      }
    ],
    "fileAssociations": [
      {
        "ext": "forma",
        "name": "Forma project",
        "description": "Forma animation project",
        "mimeType": "application/x-forma-project",
        "role": "Editor"
      }
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Forma-Animation-Studio-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "Forma-Animation-Studio-${version}-${arch}-portable.${ext}"
    }
  },
  "dependencies": {
    "ajv": "8.18.0",
    "electron-updater": "6.8.10"
  }
}
